# HyperFrames state, media preferences, capture intermediates, and renders are
# local/generated. The reproducible authored source and reviewed top-level
# assets remain outside these directories and can be committed deliberately.
videos/**/.hyperframes/
videos/**/.media/
videos/**/capture/
videos/**/renders/
videos/**/snapshots/
videos/bim-review-agent-promo/assets/audio/minimax/

# Local video brief and orchestration metadata are not render dependencies and
# are excluded from the redacted submission bundle.

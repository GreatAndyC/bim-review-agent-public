# Local prototype limits. Deterministic review does not require an AI API key.
BIM_REVIEW_MAX_UPLOAD_MB=50
BIM_REVIEW_RUN_LIMIT=20
# Optional local SQLite path. Never point this at a synced/shared location containing secrets.
# BIM_REVIEW_MEMORY_DB=/absolute/path/to/bim-review-memory.sqlite3

# Optional external model provider. It is disabled by default and never selected by `auto`.
# Enabling it may send the objective and safe structured observations to the configured service
# and may incur provider charges. Keep the key only in the process environment; never commit it.
# BIM_REVIEW_EXTERNAL_PROVIDER_ENABLED=1
# BIM_REVIEW_EXTERNAL_PROVIDER_BASE_URL=https://api.openai.com/v1
# BIM_REVIEW_EXTERNAL_PROVIDER_MODEL=your-responses-model-id
# BIM_REVIEW_EXTERNAL_PROVIDER_TIMEOUT_SECONDS=30
# BIM_REVIEW_MODEL_API_KEY=

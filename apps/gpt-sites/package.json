{
  "name": "@bim-review-agent/gpt-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:agent-kernel && npm run test:quick-check && npm run test:batch-quick-check && npm run test:upload-boundary && npm run build && npm run test:render && npm run test:workerd",
    "test:agent-kernel": "node scripts/agent-kernel-smoke.mjs",
    "test:quick-check": "node --import tsx --test tests/quick-check.test.mjs",
    "test:batch-quick-check": "node --import tsx --test tests/batch-quick-check.test.mjs",
    "test:upload-boundary": "node --import tsx --test tests/upload-boundary.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "test:workerd": "node scripts/workerd-integration.mjs",
    "smoke:phase0": "node scripts/phase0-smoke.mjs",
    "smoke:equivalence": "node scripts/equivalence-smoke.mjs",
    "smoke:agent": "node scripts/agent-smoke.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260809.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
